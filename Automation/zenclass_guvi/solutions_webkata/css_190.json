{
  "HTML": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Display the grid items with a padding value of 20px using the css selector(grid container)</title>\n    <style>\n        .grid-container > div {\n            padding: 20px;\n            border: 2px solid black;\n            background-color: #f1f1f1;\n            text-align: center;\n            font-size: 30px;\n        }\n\n        .grid-container {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 10px;\n            padding: 20px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"grid-container\">\n        <div>Item 1</div>\n        <div>Item 2</div>\n        <div>Item 3</div>\n        <div>Item 4</div>\n        <div>Item 5</div>\n        <div>Item 6</div>\n    </div>\n</body>\n</html>"
}