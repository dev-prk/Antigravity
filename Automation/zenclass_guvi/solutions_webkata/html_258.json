{
  "HTML": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\">\n    <title>Static Template</title>\n    <style>\n      h1 {\n        font-size: 2em;\n        font-weight: bold;\n      }\n      .progress-container {\n        margin-bottom: 10px;\n      }\n      .skill-name {\n        font-weight: bold;\n        margin-right: 10px;\n      }\n      .progress-bar {\n        width: 72%;\n        height: 20px;\n        background-color: #4CAF50;\n      }\n    </style>\n  </head>\n  <body>\n    <h1>SkillSet</h1>\n    <div class=\"progress-container\">\n      <label for=\"java\" id=\"java\">Java with 72%</label>\n      <progress id=\"java\" value=\"72\" max=\"100\"></progress>\n    </div>\n    <div class=\"progress-container\">\n      <label for=\"python\" id=\"python\">Python with 95%</label>\n      <progress id=\"python\" value=\"95\" max=\"100\"></progress>\n    </div>\n    <div class=\"progress-container\">\n      <label for=\"c\" id=\"c\">C with 63%</label>\n      <progress id=\"c\" value=\"63\" max=\"100\"></progress>\n    </div>\n    <div class=\"progress-container\">\n      <label for=\"cpp\" id=\"cpp\">C++ with 43%</label>\n      <progress id=\"cpp\" value=\"43\" max=\"100\"></progress>\n    </div>\n  </body>\n</html>"
}