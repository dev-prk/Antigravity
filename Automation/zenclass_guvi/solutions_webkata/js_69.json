{
  "HTML": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\">\n    <title>Static Template</title>\n  </head>\n  <body oninput=\"displaySelectedOption()\">\n      <input type=\"radio\" name=\"option\" id=\"option1\" value=\"opt1\">\n      <label for=\"option1\">Option 1</label>\n      <input type=\"radio\" name=\"option\" id=\"option2\" value=\"opt2\">\n      <label for=\"option2\">Option 2</label>\n      <input type=\"radio\" name=\"option\" id=\"option3\" value=\"opt3\">\n      <label for=\"option3\">Option 3</label>\n      <input type=\"radio\" name=\"option\" id=\"option4\" value=\"opt4\">\n      <label for=\"option4\">Option 4</label>\n      <input type=\"radio\" name=\"option\" id=\"option5\" value=\"opt5\">\n      <label for=\"option5\">Option 5</label>\n      <input type=\"radio\" name=\"option\" id=\"option6\" value=\"opt6\">\n      <label for=\"option6\">Option 6</label>\n      <p>The Selected option is </p>\n      <p id=\"selectedOption\"></p>\n  </body>\n</html>",
  "JavaScript": "function displaySelectedOption(){\n    const radios = document.getElementsByName('option');\n    let selectedValue = '';\n    for (let i = 0; i < radios.length; i++) {\n        if (radios[i].checked) {\n            selectedValue = radios[i].value;\n            break;\n        }\n    }\n    document.getElementById('selectedOption').textContent = selectedValue;\n}\ndisplaySelectedOption();"
}