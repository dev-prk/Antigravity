{
  "HTML": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\">\n    <title>Static Template</title>\n    <script>\n      function fun() {\n        const input = document.getElementById('in1').value;\n        const numbers = input.split(',').map(num => parseInt(num.trim()));\n        const filtered = numbers.filter(num => num >= 5);\n        filtered.sort((a, b) => a - b);\n        document.getElementById('result').textContent = filtered.join(',');\n      }\n    </script>\n  </head>\n\n<body><input id='in1' oninput='fun()'><p id=\"result\"></p>\n\n\n</body></html>",
  "JavaScript": "function fun() {\n  const input = document.getElementById('in1').value;\n  const numbers = input.split(',').map(num => parseInt(num.trim()));\n  const filtered = numbers.filter(num => num >= 5);\n  filtered.sort((a, b) => a - b);\n  document.getElementById('result').textContent = filtered.join(',');\n}"
}