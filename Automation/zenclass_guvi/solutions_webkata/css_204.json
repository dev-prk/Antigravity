{
  "HTML": "<!DOCTYPE html>\n<html>\n<head>\n<title>Page Title</title>\n<style>\n   .grid-container {\n        display: grid;\n        grid-template-columns: 100px 200px;\n        grid-gap: 20px;\n        padding: 10px;\n        background-color: dodgerblue;\n    }\n    .grid-container > div {\n        padding: 10px;\n        text-align: center;\n        font-size: 30px;\n        background-color: #f1f1f1;\n    }\n</style>\n</head>\n<body>\n   <div class=\"grid-container\">\n        <div>1</div>\n        <div>2</div>\n        <div>3</div>\n        <div>4</div>\n        <div>5</div>\n        <div>6</div>\n    </div>\n</body>\n</html>"
}